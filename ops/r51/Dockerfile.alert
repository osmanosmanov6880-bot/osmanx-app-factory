FROM node:22.15-alpine
WORKDIR /app
COPY src/migration/r51-alert-ack.mjs /app/src/migration/r51-alert-ack.mjs
COPY ops/r51/alert-server.mjs /app/ops/r51/alert-server.mjs
RUN chown -R node:node /app
USER node
ENV NODE_ENV=production OX_R51_ALERT_PORT=9082
EXPOSE 9082
CMD ["node", "/app/ops/r51/alert-server.mjs"]
