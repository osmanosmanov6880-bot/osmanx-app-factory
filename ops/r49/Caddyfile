# Caddy obtains TLS certificates only after DNS and public 80/443 are set.
{$OX_R49_WITNESS_DOMAIN} {
    encode zstd gzip
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000"
    }
    request_body {
        max_size 16KB
    }
    reverse_proxy witness:9080
}
