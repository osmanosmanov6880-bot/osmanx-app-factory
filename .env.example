# Optional: defaults to 4173 for factory, 4180 for a standalone export
PORT=4173
HOST=127.0.0.1
# Optional: a directory for local SQLite databases
# DATA_DIR=./data
# Needed when first binding publicly; generate a high-entropy secret (20+ characters)
# SETUP_TOKEN=do-not-commit-real-secrets
# Use only behind configured HTTPS
COOKIE_SECURE=0
